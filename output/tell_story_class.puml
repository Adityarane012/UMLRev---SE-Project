@startuml
title Feature: Tell Story - Class Diagram
skinparam classAttributeIconSize 0
skinparam roundcorner 5
skinparam packageStyle rectangle
class Enemy {
  - name: String
  + capture(Princess_princess): void
  + guard(Princess_princess): void
}
class Hero {
  - name: String
  + save(Princess_princess): void
  + fight(Enemy_enemy): void
}
class Princess {
  - name: String
  - isCaptured: boolean
  + setCaptured(boolean_captured): void
  + release(): void
  + getName(): String
}
class Story {
  - hero: Hero
  - enemy: Enemy
  - princess: Princess
  + start(): void
  + tell(): void
}
Enemy ..> Princess : capture
Hero ..> Princess : save
Story --> Hero : hero
Story --> Enemy : enemy
Story --> Princess : princess
Story ..> Enemy : start
Story ..> Hero : start
@enduml