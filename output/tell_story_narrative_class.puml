@startuml
title Feature: Tell Story Narrative - Class Diagram
skinparam classAttributeIconSize 0
skinparam roundcorner 5
skinparam packageStyle rectangle
class Story {
  - hero: Hero
  - enemy: Enemy
  - princess: Princess
  + start(): void
  + tell(): void
}
class Enemy {
  - name: String
  + capture(Princess princess): void
  + guard(Princess princess): void
}
class Hero {
  - name: String
  + save(Princess princess): void
  + fight(Enemy enemy): void
}
class Princess {
  - name: String
  - isCaptured: boolean
  + setCaptured(boolean captured): void
  + release(): void
  + getName(): String
}
Enemy ..> Princess : capture
Enemy ..> Princess : guard
Hero ..> Princess : save
Hero ..> Princess : fight
Story --> Hero : hero
Story --> Enemy : enemy
Story --> Princess : princess
Story ..> Enemy : start
Story ..> Hero : start
Story ..> Hero : start
Story ..> Enemy : tell
Story ..> Hero : tell
Story ..> Hero : tell
@enduml